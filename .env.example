VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-browser-publishable-key
# Required for tenant-scoped reads; leave unset to keep the dashboard unconfigured.
VITE_SUPABASE_WORKSPACE_ID=<workspace-uuid>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<your_anon_or_server_key>
SESSION_ID=<will_be_generated>
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace/me
SLACK_SIGNING_SECRET=replace-with-slack-signing-secret
AGENTBREAKER_SLACK_TIMEOUT_SECONDS=60
MODEL_NAME=gpt-4
AGENT_ID=<optional-agent-uuid>
AGENTBREAKER_PRICING_CONFIG=pricing_config.json
