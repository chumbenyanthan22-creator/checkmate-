# Browser-safe Supabase Auth values (publishable key only; never put a service-role key under VITE_).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<browser-publishable-key>

# Vercel server-only values. Configure in Vercel project environment settings.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>
SOVEREIGNHALT_ALLOWED_EMAILS=<authorized-supabase-user-email>
# In Vercel, enter this as a JSON array without surrounding single quotes.
# Each real agent requires a unique token of at least 32 characters.
SOVEREIGNHALT_INGEST_AGENTS_JSON='[{"name":"<actual-agent-name>","slug":"<stable-agent-slug>","token":"<unique-high-entropy-token>","agent_class":"standard","risk_level":"low"}]'
# The workspace slug/name/plan marker are fixed server-side and are not environment overrides.

# Python API-only producer. The token must match exactly one server registry entry.
# The bearer token selects the server-owned profile; local name/slug are not sent as identity claims.
SOVEREIGNHALT_INGEST_URL=https://<your-vercel-domain>/api/telemetry/ingest
SOVEREIGNHALT_INGEST_TOKEN=<unique-token-for-this-agent>
SOVEREIGNHALT_AGENT_NAME=<actual-agent-name>
SOVEREIGNHALT_AGENT_SLUG=<stable-agent-slug>

# Legacy direct-Supabase session/cost mode is disabled by default. Enable only in a trusted
# server runtime with SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY; API-only ingestion ignores it.
SOVEREIGNHALT_LEGACY_DIRECT_SUPABASE=false
SESSION_ID=<will-be-generated>
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace/me
SLACK_SIGNING_SECRET=replace-with-slack-signing-secret
AGENTBREAKER_SLACK_TIMEOUT_SECONDS=60
MODEL_NAME=gpt-4
AGENTBREAKER_PRICING_CONFIG=pricing_config.json
